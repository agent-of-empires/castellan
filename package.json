{
	"name": "castellan",
	"version": "0.3.3",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"castellan": "dist/cli/index.mjs"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "node scripts/build.mjs",
		"check:bundles": "node scripts/check-bundles.mjs",
		"eval": "node dist/eval.mjs",
		"test:bundle": "node --input-type=module -e \"const m = await import('./dist/lambda/index.mjs'); if (typeof m.handler !== 'function') throw new Error('no handler export')\"",
		"lint": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "^1.1.1",
		"@anthropic-ai/sdk": "^1.6.0",
		"@aws-sdk/client-secrets-manager": "^3.1164.0",
		"octokit": "^5.0.5",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	}
}
